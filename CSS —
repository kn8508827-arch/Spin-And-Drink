
.wheel-center-logo {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 30%;
  aspect-ratio: 1 / 1;
  z-index: 10;
  border-radius: 50%;
  overflow: hidden;
  background: transparent;
  pointer-events: none;
}

.wheel-center-logo .center-logo {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  background: transparent;
  border: none;
  box-shadow: none;
}
